{"element":{"atomicNumber":60,"symbol":"Nd","name":"Neodymium","wikidataId":"Q1388","wikipediaTitle":"Neodymium","wikipediaUrl":"https://en.wikipedia.org/wiki/Neodymium","period":6,"group":null,"block":"f","category":"lanthanide","phase":"solid","mass":144.24,"electronegativity":1.14,"ionizationEnergy":5.525,"radius":229,"summary":"Neodymium is a chemical element; it has symbol Nd and atomic number 60. It is the fourth member of the lanthanide series and is considered to be one of the rare-earth metals. It is a hard, slightly malleable, silvery metal that quickly tarnishes in air and moisture. When oxidized, neodymium reacts quickly, producing pink, purple/blue, and yellow compounds in the +2, +3 and +4 oxidation states. It is generally regarded as having one of the most complex spectra of the elements. Neodymium was discovered in 1885 by the Austrian chemist Carl Auer von Welsbach, who also discovered praseodymium. Neodymium is present in significant quantities in the minerals monazite and bastnäsite. Neodymium is not found naturally in metallic form or unmixed with other lanthanides, and it is usually refined for general use. Neodymium is fairly common—about as common as cobalt, nickel, or copper—and is widely distributed in the Earth's crust. Most of the world's commercial neodymium is mined in China, as is the case with many other rare-earth metals.","neighbors":["Pr","Pm"],"rankings":{"mass":59,"electronegativity":81,"ionizationEnergy":91,"radius":27,"density":49,"meltingPoint":48,"boilingPoint":32,"halfLife":0},"sources":{"structured":{"provider":"PubChem","license":"public domain","url":"https://pubchem.ncbi.nlm.nih.gov/element/60"},"identifiers":{"provider":"Wikidata","license":"CC0 1.0","url":"https://www.wikidata.org/wiki/Q1388"},"summary":{"provider":"Wikipedia","title":"Neodymium","url":"https://en.wikipedia.org/wiki/Neodymium","license":"CC BY-SA 4.0","accessDate":"2026-03-30"}},"discoveryYear":1885,"discoverer":"Carl Auer von Welsbach","etymologyOrigin":"property","etymologyDescription":"Greek neos + didymos: new twin","density":7.01,"meltingPoint":1294,"boilingPoint":3347,"halfLife":null},"group":null,"anomalies":[{"slug":"f-block-gap","label":"f-block discontinuity","elementCount":28}],"nav":{"prevInGroup":null,"nextInGroup":null,"prevInPeriod":{"symbol":"Pr","name":"Praseodymium"},"nextInPeriod":{"symbol":"Pm","name":"Promethium"},"prevInBlock":{"symbol":"Pr","name":"Praseodymium"},"nextInBlock":{"symbol":"Pm","name":"Promethium"},"prevInCategory":{"symbol":"Pr","name":"Praseodymium"},"nextInCategory":{"symbol":"Pm","name":"Promethium"}},"groupPhases":null,"neighbors":[{"symbol":"Pr","name":"Praseodymium","block":"f"},{"symbol":"Pm","name":"Promethium","block":"f"}],"sameDiscoverer":[{"symbol":"Pr","name":"Praseodymium","block":"f"}],"sameEtymology":[{"symbol":"H","name":"Hydrogen","block":"s"},{"symbol":"Li","name":"Lithium","block":"s"},{"symbol":"C","name":"Carbon","block":"p"},{"symbol":"N","name":"Nitrogen","block":"p"},{"symbol":"O","name":"Oxygen","block":"p"},{"symbol":"F","name":"Fluorine","block":"p"},{"symbol":"Ne","name":"Neon","block":"p"},{"symbol":"Na","name":"Sodium","block":"s"},{"symbol":"Si","name":"Silicon","block":"p"},{"symbol":"S","name":"Sulfur","block":"p"},{"symbol":"Cl","name":"Chlorine","block":"p"},{"symbol":"Ar","name":"Argon","block":"p"},{"symbol":"K","name":"Potassium","block":"s"},{"symbol":"Ca","name":"Calcium","block":"s"},{"symbol":"Cr","name":"Chromium","block":"d"},{"symbol":"Fe","name":"Iron","block":"d"},{"symbol":"Zn","name":"Zinc","block":"d"},{"symbol":"As","name":"Arsenic","block":"p"},{"symbol":"Br","name":"Bromine","block":"p"},{"symbol":"Kr","name":"Krypton","block":"p"},{"symbol":"Rb","name":"Rubidium","block":"s"},{"symbol":"Tc","name":"Technetium","block":"d"},{"symbol":"Rh","name":"Rhodium","block":"d"},{"symbol":"Ag","name":"Silver","block":"d"},{"symbol":"In","name":"Indium","block":"p"},{"symbol":"Sn","name":"Tin","block":"p"},{"symbol":"I","name":"Iodine"